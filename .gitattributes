# Git attributes for Course-at-GB
# Educational monorepository: web, Node.js, Python, Java, PHP/Laravel and .NET.

# ==============================================================================
# Default text handling
# ==============================================================================

# Detect text files automatically, store them in Git with LF line endings,
# and let Git convert them for the working tree when explicitly overridden below.
* text=auto eol=lf

# ==============================================================================
# Repository metadata and documentation
# ==============================================================================

.gitattributes text eol=lf
.gitignore text eol=lf
.editorconfig text eol=lf

